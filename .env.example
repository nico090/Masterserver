VPS_PUBLIC_IP=tu.ip.publica
GAME_SERVER_PATH=/opt/gameserver/BossRoom.x86_64
GAME_SERVER_DIR=/opt/gameserver
PORT_RANGE_START=7770
PORT_RANGE_END=7870
SERVER_SECRET=genera-un-secreto-seguro
ADMIN_API_KEY=genera-otra-clave-admin
MAX_ROOMS_PER_MINUTE=5
LOG_DIR=logs
# URL interna que el game server usa para enviar heartbeats al master server.
# Si ambos corren en el mismo contenedor (subprocess): http://127.0.0.1:8000
# Si el game server está en otro contenedor del mismo compose: http://master-server:8000
MASTER_SERVER_INTERNAL_URL=http://127.0.0.1:8000
